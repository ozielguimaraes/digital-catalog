<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeuCatalogo.Components.SectionHeader"
             x:Name="Root">
    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Margin="0,16,0,8">
        <Label Grid.Column="0"
               Style="{StaticResource SerifH3}"
               Text="{Binding Title, Source={x:Reference Root}}"
               VerticalOptions="Center" />
        <Label Grid.Column="1"
               Style="{StaticResource CapsPrimary}"
               Text="{Binding ActionText, Source={x:Reference Root}}"
               VerticalOptions="Center"
               IsVisible="{Binding HasAction, Source={x:Reference Root}}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ActionCommand, Source={x:Reference Root}}"
                                      CommandParameter="{Binding ActionCommandParameter, Source={x:Reference Root}}" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</ContentView>
