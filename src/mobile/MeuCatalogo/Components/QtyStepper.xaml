<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeuCatalogo.Components.QtyStepper"
             x:Name="Root">
    <Border StrokeThickness="1"
            Stroke="{StaticResource BorderBrush}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColorLight}, Dark={StaticResource SurfaceColorDark}}"
            Padding="0"
            HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="22" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="40,Auto,40" MinimumHeightRequest="40" MinimumWidthRequest="120">
            <Label Grid.Column="0"
                   Text="−"
                   FontFamily="LatoBold"
                   FontSize="20"
                   TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDecrementTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1"
                   x:Name="QuantityLabel"
                   FontFamily="LatoBold"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   MinimumWidthRequest="32" />
            <Label Grid.Column="2"
                   Text="+"
                   FontFamily="LatoBold"
                   FontSize="20"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, Dark={StaticResource PrimaryColorDark}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnIncrementTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Border>
</ContentView>
