<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:produto="clr-namespace:MeuCatalogo.Features.Produto.Presentation"
             xmlns:catalogo="clr-namespace:MeuCatalogo.Features.Catalogo"
             xmlns:contracts="clr-namespace:MeuCatalogo.Features.Produto.Data.Remote.Contracts.Responses"
             xmlns:components="clr-namespace:MeuCatalogo.Components"
             x:Class="MeuCatalogo.Features.Produto.Presentation.ProdutoDetalhePage"
             x:DataType="produto:ProdutoDetalhePageViewModel">

    <Shell.TitleView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
            <Label Style="{StaticResource Caps}" Text="{Binding CategoriaNome}" IsVisible="{Binding TemCategoria}" />
            <Label Text="{Binding Nome}" FontFamily="LoraMedium" FontSize="18" LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
    </Shell.TitleView>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Cover hero (fundo escuro, imagem AspectFill por cima, badge PROMO opcional) -->
                <Grid HeightRequest="340">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PromoBackgroundColorLight}, Dark={StaticResource PromoBackgroundColorDark}}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,0,32,32" />
                        </Border.StrokeShape>
                        <Image Aspect="AspectFill"
                               IsVisible="{Binding CapaUrl, Converter={x:Static catalogo:NotNullOrEmptyConverter.Instance}}">
                            <Image.Source>
                                <UriImageSource Uri="{Binding CapaUrl}" CacheValidity="1.00:00:00" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <!-- Badge PROMO -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, Dark={StaticResource PrimaryColorDark}}"
                            StrokeThickness="0"
                            Padding="12,6"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="20,20,0,0"
                            IsVisible="{Binding TemDesconto}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="99" />
                        </Border.StrokeShape>
                        <Label Text="PROMO"
                               FontFamily="LatoBold"
                               FontSize="11"
                               CharacterSpacing="2"
                               TextColor="{StaticResource OnPrimaryColor}" />
                    </Border>
                </Grid>

                <VerticalStackLayout Padding="20,20,20,24" Spacing="14">

                    <!-- Categoria + nome + preço -->
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource Caps}"
                               Text="{Binding CategoriaNome}"
                               IsVisible="{Binding TemCategoria}" />
                        <Label Style="{StaticResource SerifH1}"
                               Text="{Binding Nome}"
                               LineBreakMode="WordWrap" />
                        <components:PriceTag Margin="0,6,0,0"
                                             Preco="{Binding Preco}"
                                             PrecoComDesconto="{Binding PrecoComDesconto}" />
                    </VerticalStackLayout>

                    <!-- Galeria -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding TemGaleria}">
                        <components:SectionHeader Title="Galeria" />
                        <CollectionView ItemsSource="{Binding Imagens}"
                                        HeightRequest="124"
                                        SelectionMode="None"
                                        ItemsUpdatingScrollMode="KeepItemsInView">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="contracts:ProdutoImagemResponse">
                                    <Border StrokeThickness="0"
                                            HeightRequest="120"
                                            WidthRequest="120"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedColorLight}, Dark={StaticResource SurfaceMutedColorDark}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Image Aspect="AspectFill" Source="{Binding Images.Medium}" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Descrição -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding TemInformacoes}">
                        <components:SectionHeader Title="Descrição" />
                        <Label Text="{Binding InformacoesAdicionais}"
                               FontFamily="LatoRegular"
                               FontSize="14"
                               LineHeight="1.5" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky CTA -->
        <Border Grid.Row="1"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColorLight}, Dark={StaticResource SurfaceColorDark}}"
                Padding="20,12,20,18">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="12" Opacity="0.06" />
            </Border.Shadow>
            <Button Style="{StaticResource PrimaryButtonPill}"
                    Text="EDITAR PRODUTO"
                    Command="{Binding EditarCommand}" />
        </Border>
    </Grid>
</ContentPage>
