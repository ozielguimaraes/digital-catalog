<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:components="clr-namespace:MeuCatalogo.Components"
             x:Class="MeuCatalogo.Features.Produto.ProdutoListaPage"
             x:Name="ProdutoListaPageRoot"
             xmlns:produto="clr-namespace:MeuCatalogo.Features.Produto"
             xmlns:domain="clr-namespace:MeuCatalogo.Features.Produto.Domain"
             xmlns:fonts="clr-namespace:MeuCatalogo.Resources.Fonts"
             x:DataType="produto:ProdutoListaPageViewModel">

    <Shell.TitleView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="0">
            <Label Style="{StaticResource Caps}" Text="ATELIÊ" />
            <Label Text="Produtos" FontFamily="LoraMedium" FontSize="18" />
        </VerticalStackLayout>
    </Shell.TitleView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AdicionarCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                 Glyph="{x:Static fonts:FluentUI.add_24_regular}"
                                 Color="{AppThemeBinding Light={StaticResource PrimaryColorLight}, Dark={StaticResource PrimaryColorDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Source={x:Reference ProdutoListaPageRoot}, Path=BindingContext}"
            EventName="Appearing"
            Command="{Binding CarregarDadosCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="*">

        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,8,20,0" RowSpacing="0">

            <!-- Search pílula -->
            <Border Grid.Row="0" Style="{StaticResource SearchPill}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                           Text="{x:Static fonts:FluentUI.search_24_regular}"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedColorLight}, Dark={StaticResource TextMutedColorDark}}"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           Placeholder="Buscar produto"
                           ReturnType="Search"
                           BackgroundColor="Transparent"
                           FontFamily="LatoRegular"
                           FontSize="14"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Chips de categoria -->
            <components:CategoryChipScroll Grid.Row="1"
                                           Margin="0,16,0,0"
                                           ItemsSource="{Binding Categorias}"
                                           SelectedItem="{Binding CategoriaSelecionada, Mode=TwoWay}"
                                           DisplayMemberPath="Nome" />

            <!-- Seção -->
            <components:SectionHeader Grid.Row="2" Title="Produtos" />

            <!-- Estado: loading / vazio / grid -->
            <Grid Grid.Row="3">

                <!-- Loading -->
                <VerticalStackLayout IsVisible="{Binding IsSyncing}"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Padding="0,48"
                                     Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsSyncing}"
                                       WidthRequest="36"
                                       HeightRequest="36" />
                    <Label Style="{StaticResource BodyMuted}"
                           HorizontalTextAlignment="Center"
                           Text="Carregando produtos…" />
                </VerticalStackLayout>

                <!-- Vazio -->
                <VerticalStackLayout IsVisible="{Binding ShowEmptyState}"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Padding="0,48"
                                     Spacing="12">
                    <Border Style="{StaticResource IconCircleSurface}"
                            HeightRequest="92"
                            WidthRequest="92"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="46" />
                        </Border.StrokeShape>
                        <Image Source="ic_x_mark_circle_thin.png"
                               HeightRequest="44"
                               Aspect="AspectFit">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource PrimaryColorLight}, Dark={StaticResource PrimaryColorDark}}" />
                            </Image.Behaviors>
                        </Image>
                    </Border>

                    <Label Style="{StaticResource SerifH2}"
                           HorizontalTextAlignment="Center"
                           Text="Nenhum produto ainda" />
                    <Label Style="{StaticResource BodyMuted}"
                           HorizontalTextAlignment="Center"
                           Text="Adicione seu primeiro produto para começar a vender." />
                    <Button Style="{StaticResource PrimaryButtonPill}"
                            Text="ADICIONAR PRODUTO"
                            HorizontalOptions="Center"
                            Margin="0,8,0,0"
                            WidthRequest="240"
                            IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"
                            Command="{Binding AdicionarCommand}" />
                </VerticalStackLayout>

                <!-- Grid 2-col de produtos -->
                <RefreshView Command="{Binding CarregarDadosCommand}"
                             IsRefreshing="{Binding IsRefreshing}">
                    <CollectionView ItemsSource="{Binding ProdutosFiltrados}"
                                    SelectionMode="None"
                                    ItemsUpdatingScrollMode="KeepItemsInView">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="2"
                                             VerticalItemSpacing="14"
                                             HorizontalItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:ProdutoEntity">
                                <components:ProductGridCard
                                    ThumbnailSource="{Binding ThumbnailUrl}"
                                    Nome="{Binding Nome}"
                                    Preco="{Binding Preco}"
                                    PrecoComDesconto="{Binding PrecoComDesconto}"
                                    SubtitleText="{Binding CategoriaNome}"
                                    TapCommand="{Binding Source={RelativeSource AncestorType={x:Type produto:ProdutoListaPageViewModel}}, Path=VerDetalheCommand}"
                                    TapCommandParameter="{Binding .}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

            </Grid>
        </Grid>

        <!-- Busy overlay -->
        <Grid BackgroundColor="#A0121212"
              IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource OnPrimaryColor}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
